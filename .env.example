# ScamShield AI - Environment Variables
# Obtain your Gemini API key from Google AI Studio: https://aistudio.google.com/app/apikey

# Google Gemini API Key (Optional but recommended for Deep AI Threat Analysis)
# If left empty, ScamShield AI automatically falls back to its deterministic Heuristic Rule Engine.
GEMINI_API_KEY=your_gemini_api_key_here

# Application Configuration
NEXT_PUBLIC_APP_NAME="ScamShield AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
